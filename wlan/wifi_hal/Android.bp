soong_namespace {
}

soong_config_module_type {
    name: "mediatek_wifi_hal_defaults",
    module_type: "cc_defaults",
    config_namespace: "mediatek_wifi_hal",
    bool_variables: [
        "use_pre_u_qpr2_struct",
    ],
    properties: [
        "cflags",
    ],
}

mediatek_wifi_hal_defaults {
    name: "mediatek_wifi_hal_defaults",
    soong_config_variables: {
        use_pre_u_qpr2_struct: {
            cflags: [
                "-DUSE_PRE_U_QPR2_STRUCT",
            ],
        },
    },
}

cc_library {
    name: "libwifi-hal-mediatek",
    defaults: ["mediatek_wifi_hal_defaults"],
    vendor: true,
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-int-to-pointer-cast",
        "-Wno-maybe-uninitialized",
        "-Wno-parentheses",
        "-Wno-conversion-null",
    ],
    header_libs: [
        "libnetlink_iface_headers",
        "wifi_legacy_headers",
    ],
    srcs: [
        "wifi_hal.cpp",
        "common.cpp",
        "cpp_bindings.cpp",
        "wifi_logger.cpp",
        "wifi_offload.cpp",
        "nan.cpp",
        "nan_ind.cpp",
        "nan_req.cpp",
        "nan_rsp.cpp",
        "wifi_rtt.cpp",
    ],
    shared_libs: [
        "libutils",
        "liblog",
        "libnl",
    ],
}
